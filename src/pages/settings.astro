---
import Base from "../layouts/Base.astro";
import SettingsClient from "../components/SettingsClient";

const googleConfigured = !!Astro.locals.runtime.env.GOOGLE_CLIENT_ID;
---

<Base title="設定">
  <h1>設定</h1>
  <SettingsClient client:only="react" googleConfigured={googleConfigured} />

  <section class="card" style="margin-top:22px">
    <h2 style="margin-top:0">モデレーションについて</h2>
    <p class="small muted">
      各動画のコメント欄の「誰が返信できるか」はBlueskyのthreadgateで設定します。
      元のポストは各ユーザーのPDSに残ります。
    </p>
  </section>
</Base>
