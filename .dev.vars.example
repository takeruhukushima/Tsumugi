# Copy to `.dev.vars` for local `wrangler dev` / `astro dev` (platformProxy).
# `.dev.vars` is gitignored. Do NOT commit real secrets.

TSUMUGI_ORIGIN = "http://127.0.0.1:4321"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# Random 32+ byte secret for signing the session cookie.
#   openssl rand -hex 32
SESSION_SECRET = ""

# atproto OAuth client signing key (ES256 private JWK, single-line JSON).
# Generate one with:  node scripts/gen-jwk.mjs
ATP_PRIVATE_JWK = ""
